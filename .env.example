# Copy to .env for local development, and set the same keys in the Vercel
# project settings before deploying. Never commit the filled-in .env — it is
# covered by .gitignore.

# --- Database (Supabase Postgres) ---
# DATABASE_URL uses the pooled connection; DIRECT_URL is the direct one used
# for schema changes.
DATABASE_URL=
DIRECT_URL=

# --- Auth (NextAuth v5) ---
# Generate with: npx auth secret
AUTH_SECRET=

# --- Supabase (file storage for payment screenshots) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI tools (Groq free tier; every feature degrades cleanly without it) ---
# Free key from https://console.groq.com/keys — no card required.
# Rate-limited per minute and per day, so the in-app usage quota still applies.
GROQ_API_KEY=

# --- Canonical site URL (optional) ---
# Only needed once a real domain is bought — set it to e.g. https://scorewell.com and every
# absolute URL follows (sitemap.xml, robots.txt, canonical tags). Left unset, Vercel's
# VERCEL_PROJECT_PRODUCTION_URL is used, falling back to localhost in development.
NEXT_PUBLIC_SITE_URL=

# --- Admin access ---
# Day to day, admin access is the User.role column, managed from /admin/users.
# These emails are the bootstrap and the way back in: the migration that added `role`
# defaults everyone to USER, and the page that grants the role is itself behind the admin
# check — so without this, nobody could ever become the first admin. It also means losing
# the last admin is recoverable. Keep at least your own address here.
ADMIN_EMAILS=

# The admin account's own sign-in, kept locally so scripts and browser checks can reach the
# admin pages without a password being typed into a terminal or a chat window. Local only —
# never set these in Vercel. Nothing in the app reads them; they are for tooling.
ADMIN_ACCOUNT_EMAIL=
ADMIN_ACCOUNT_PASSWORD=

# --- Payments (optional; checkout stays closed until at least one is set) ---
# See lib/payment-config.ts. Without these the checkout page refuses payments
# rather than collecting references for money with nowhere to go.
PAYMENT_ACCOUNT_NAME=
PAYMENT_ESEWA_ID=
PAYMENT_KHALTI_ID=
PAYMENT_BANK_ACCOUNT=
# Optional: URL of the real payment QR image. No QR is shown without it.
PAYMENT_QR_URL=

# --- Firebase Auth (identity only; all application data stays in Postgres) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the service-account `private_key` value as it appears in the JSON, \n escapes and
# all. normalisePrivateKey() in lib/firebase/admin.ts accepts that shape, the multi-line
# shape, and the double-escaped one a layer of quoting produces.
FIREBASE_PRIVATE_KEY=
