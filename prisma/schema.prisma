// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider   = "prisma-client"
  output     = "../generated/prisma"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Skill {
  READING
  LISTENING
  WRITING
  SPEAKING
}

// One template/page per type, per site-build-prompt.md section 4
enum ContentType {
  PRACTICE_TEST
  SAMPLE_ANSWER
  USER_SUBMISSION
  ARTICLE
  COURSE
  AI_CONVERSATION
  WRITING_EXERCISE
  PRONUNCIATION_DRILL
  DICTATION_SHADOWING
  VIDEO_LESSON
  MINI_EXERCISE
}

// Flexible per-content-type payload lives in `data` (JSONB); common
// filterable fields stay as real columns per site-build-prompt.md section 6a/8.
model ContentItem {
  id          String      @id @default(cuid())
  contentType ContentType
  slug        String      @unique
  title       String

  skill         Skill?
  taskType      String?
  bandLevel     String?
  sourceTestSet String?
  topic         String?
  tags          String[] @default([])

  data Json

  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions   Submission[]
  progress      Progress[]
  registrations LiveLessonRegistration[]

  @@index([contentType])
  @@index([skill])
  @@index([taskType])
  @@index([bandLevel])
  @@index([sourceTestSet])
  @@index([topic])
  @@index([tags], type: Gin)
}

// site-build-prompt.md section 6: free tier = limited monthly AI tool uses,
// premium = unlimited + saved progress + mistake analytics + priority support.
enum SubscriptionTier {
  FREE
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  TRIALING
}

// site-build-prompt.md section 3: pricing table offers 1/3/6/12 month billing.
enum BillingInterval {
  MONTHLY_1
  MONTHLY_3
  MONTHLY_6
  MONTHLY_12
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  image        String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Unique share code for the refer-and-earn program (site-build-prompt.md
  // section 6). Assigned lazily the first time the user visits /refer.
  referralCode String? @unique

  // The band the learner is working towards — the "goal" in the goal-based
  // Learning Path (section 2). Set from the placement diagnostic and editable
  // afterwards. The plan itself is never stored: it is derived from this plus
  // live Progress on every visit, so it cannot go stale as the learner practises.
  targetBand Float?

  subscription       Subscription?
  submissions        Submission[]
  progress           Progress[]
  paymentSubmissions PaymentSubmission[]
  aiUsage            AiUsage[]
  referralsMade      Referral[]          @relation("ReferralsMade")
  referralReceived   Referral?           @relation("ReferralReceived")
  submissionReplies  SubmissionReply[]
  conversations      Conversation[]

  lessonRegistrations LiveLessonRegistration[]
  creditTransactions  CreditTransaction[]
  reviewRequests      ReviewRequest[]
  simulationAttempts  SimulationAttempt[]
  courseLessons       CourseLessonCompletion[]
  flashcardReviews    FlashcardReview[]
  mistakeReviews      MistakeReview[]
  featureRequests     FeatureRequest[]
  featureVotes        FeatureVote[]
}

enum ReferralStatus {
  PENDING // friend signed up but hasn't subscribed yet
  REWARDED // friend subscribed; both sides credited
}

model Referral {
  id String @id @default(cuid())

  referrerId String
  referrer   User   @relation("ReferralsMade", fields: [referrerId], references: [id])

  // A user can only ever be referred once.
  referredUserId String @unique
  referredUser   User   @relation("ReferralReceived", fields: [referredUserId], references: [id])

  status     ReferralStatus @default(PENDING)
  rewardedAt DateTime?

  createdAt DateTime @default(now())

  @@index([referrerId])
  @@index([status])
}

model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  tier             SubscriptionTier   @default(FREE)
  status           SubscriptionStatus @default(ACTIVE)
  billingInterval  BillingInterval?
  currentPeriodEnd DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// User-written answers submitted against a practice prompt, per section 4 &
// the "User-submitted answers" homepage/IELTS sections.
model Submission {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  contentItemId String?
  contentItem   ContentItem? @relation(fields: [contentItemId], references: [id])

  // Denormalised so a submission made outside a ContentItem (e.g. from a tool
  // page) still has something to display as its heading.
  title      String?
  skill      Skill?
  taskType   String?
  answerText String
  aiFeedback Json?

  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  replies       SubmissionReply[]
  reviewRequest ReviewRequest?

  @@index([userId])
  @@index([contentItemId])
  @@index([skill])
  @@index([published, createdAt])
}

/// Community feedback left on another learner's published submission.
model SubmissionReply {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  text String

  createdAt DateTime @default(now())

  @@index([submissionId])
  @@index([userId])
}

// Per-user results/mistake analytics, backing the account dashboard and
// the daily/weekly/monthly/yearly leaderboard (section 3a/4).
model Progress {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  contentItemId String?
  contentItem   ContentItem? @relation(fields: [contentItemId], references: [id])

  skill        Skill?
  taskType     String?
  score        Float?
  bandScore    Float?
  correctCount Int?
  totalCount   Int?

  // Per-question outcomes for mistake analytics (site-build-prompt.md section
  // 6, a Premium feature): [{ id, type?, correct }]. Nullable because rows
  // written before analytics existed have no per-question breakdown.
  details Json?

  // Seconds spent on the exercise, from opening it to submitting, backing the
  // dashboard's total study time (site-build-prompt.md section 6). Nullable
  // because rows written before this existed have no measurement, and those
  // attempts are excluded from the total rather than guessed at.
  //
  // Capped when recorded: an abandoned tab left open all afternoon would
  // otherwise report as study time and quietly inflate the figure.
  durationSeconds Int?

  completedAt DateTime @default(now())

  @@index([userId])
  @@index([contentItemId])
  @@index([skill])
  @@index([completedAt])
}

// Free tier gets a limited number of AI tool uses per calendar month
// (site-build-prompt.md section 6); premium is unlimited. One row per use.
model AiUsage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  tool String

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// No card processor — payment is by scanning a bank/eSewa/Khalti QR code
// and submitting proof, which an admin manually reviews (section 6:
// "region-specific payment method... for markets without wide card usage").
enum PaymentMethod {
  BANK_TRANSFER
  ESEWA
  KHALTI
}

enum PaymentSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

// A QR payment can now buy either a subscription or a pack of pay-per-use
// credits (site-build-prompt.md section 6), so the purpose is explicit rather
// than inferred — approving a credit purchase must never grant Premium.
enum PaymentPurpose {
  SUBSCRIPTION
  CREDITS
}

model PaymentSubmission {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  method  PaymentMethod
  purpose PaymentPurpose @default(SUBSCRIPTION)

  // Null for a credit purchase; set for a subscription. Existing rows all
  // carry a value, so relaxing this is non-destructive.
  billingInterval BillingInterval?

  /// Credits bought, for a CREDITS purchase. Null for a subscription.
  creditsPurchased Int?

  amountNpr      Int
  transactionRef String
  screenshotPath String?

  status     PaymentSubmissionStatus @default(PENDING)
  reviewNote String?
  reviewedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
}

// site-build-prompt.md section 4 "AI conversations". Stored server-side rather
// than replayed from the client so the turn cap and the one-AI-use-per-
// conversation charge can't be bypassed by forging a fresh message history.
model Conversation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  slug  String // the AI_CONVERSATION ContentItem slug this practises
  title String

  // [{ role: "assistant" | "user", content: string }] — the opener is stored
  // as the first assistant message so the transcript is self-contained.
  messages Json

  // Structured end-of-conversation feedback, once the learner asks for it.
  feedback Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([slug])
}

// Registration for a scheduled live lesson (site-build-prompt.md section 4b).
// The lesson itself is a ContentItem (VIDEO_LESSON + taskType "live-lesson"),
// so this only records who signed up; the attendee count is a count of rows.
model LiveLessonRegistration {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  contentItemId String
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // One registration per learner per session — makes the count honest and
  // lets "register" be idempotent.
  @@unique([userId, contentItemId])
  @@index([contentItemId])
}

// Pay-per-use credits, the subscription alternative in section 6. Stored as an
// append-only ledger rather than a mutable balance so a balance can always be
// explained: positive rows are purchases/grants, negative rows are spends.
model CreditTransaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  delta  Int
  reason String

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

enum ReviewRequestStatus {
  PENDING
  IN_REVIEW
  COMPLETED
  CANCELLED
}

enum SimulationStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

// Paid human examiner evaluation layered on top of AI scoring (section 6).
// One request per submission; the turnaround stated at purchase time is stored
// on the row so a later change to pricing cannot alter a promise already made.
model ReviewRequest {
  id String @id @default(cuid())

  submissionId String     @unique
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  status          ReviewRequestStatus @default(PENDING)
  turnaroundHours Int
  creditsCharged  Int                 @default(0)
  reviewerNotes   String?
  completedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// A full four-skill sitting under one global clock (site-build-prompt.md
// section 4b: "full four-skill simulation sitting with one global clock").
// Kept separate from Progress/Submission, which stay driven by standalone
// per-skill practice, so one sitting's four results and overall band live on
// a single row instead of a synthetic join across four unrelated tables.
model SimulationAttempt {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // The ContentItem.sourceTestSet shared by the four practice tests this
  // sitting is built from (see lib/content/exam-library.ts collection logic).
  sourceTestSet String
  status        SimulationStatus @default(IN_PROGRESS)

  listeningBand Float?
  readingBand   Float?
  writingBand   Float?
  speakingBand  Float?
  overallBand   Float?

  // Per-skill outcome payloads, same shapes their standalone flows already
  // produce: Progress.details for Listening/Reading, WritingCheckResult for
  // Writing, SpeakingCheckResult for Speaking. Null until that skill's leg
  // of the sitting is completed.
  listeningDetails Json?
  readingDetails   Json?
  writingFeedback  Json?
  speakingFeedback Json?

  // What the learner actually produced in the two unscorable legs. Kept on the
  // sitting rather than as Submission rows because a sitting owns its own work:
  // a Submission is created from this text only when the learner later chooses
  // to publish it, have it AI-evaluated, or send it for human review, which is
  // the point those rails need one. Writing and Speaking therefore carry no band
  // until such an evaluation runs — nothing here infers a score from text alone.
  writingResponse    String?
  speakingTranscript String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId])
  @@index([sourceTestSet])
  @@index([status])
}

// One lesson of a self-study course track ticked off (site-build-prompt.md section 4b,
// "self-study course track"). Courses were a reading list; this is what makes them a
// track you work through and can resume.
//
// Deliberately not a `Progress` row. Progress feeds the band trend, study-time total and
// mistake analytics, all of which read its score/details columns — a lesson tick has
// neither, and would have shown up in the analytics page's "attempts without a
// breakdown" count as though it were an unanalysed test.
//
// Keyed by slug and index rather than a ContentItem relation because a lesson is an entry
// inside the course's JSONB payload, not a row of its own. Reordering a course's lessons
// therefore reassigns ticks, which is the same trade the seed data already makes.
model CourseLessonCompletion {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  courseSlug  String
  lessonIndex Int

  completedAt DateTime @default(now())

  @@unique([userId, courseSlug, lessonIndex])
  @@index([userId, courseSlug])
}

// An email captured by the homepage newsletter block (site-build-prompt.md section 3,
// item 20).
//
// No mailing service is wired up — the standing zero-running-cost rule means one has to be
// chosen and paid for deliberately — so this table is a list, not a queue. That is also why
// there is no confirmation token: double opt-in is only meaningful once something can send
// the confirmation email, and a token column nothing writes to would be a promise the site
// does not keep. Whoever adds sending adds verification with it.
//
// `source` records which block the address came from, so a second capture point later can
// be told apart from this one without a migration.
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// One learner's scheduling state for one flashcard (site-build-prompt.md section 6,
// "spaced-repetition prompts for flashcards").
//
// Leitner boxes rather than SM-2. The intervals are a fixed ladder (see lib/flashcards.ts),
// which means a learner can be told exactly when a card comes back and why — SM-2's ease
// factors drift per card and cannot be explained on screen without teaching the algorithm.
// For a deck of exam vocabulary the difference in retention is not worth that.
//
// Keyed by the card's own stable key rather than its position in the deck, so reordering or
// inserting cards in the seed does not silently reassign somebody's review history.
model FlashcardReview {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  deckSlug String
  cardKey  String

  /** Leitner box, 1 (new/just missed) upwards. Drives the next interval. */
  box Int @default(1)

  dueAt          DateTime
  lastReviewedAt DateTime @default(now())
  reviewCount    Int      @default(0)
  /** Times this card was answered wrong after having been answered right. */
  lapses Int @default(0)

  @@unique([userId, deckSlug, cardKey])
  @@index([userId, dueAt])
}

// A question this learner got wrong, scheduled to come back (site-build-prompt.md section 6,
// "spaced-repetition prompts for ... past mistakes").
//
// Shares the Leitner ladder in lib/flashcards.ts with FlashcardReview but not its table: a
// mistake is identified by the question it belongs to, and squeezing a contentItemId and a
// questionId into a deck's "cardKey" would have made both features harder to read and one of
// them impossible to index properly.
//
// Only questions from self-contained exercises are queued — see lib/content/mistakes.ts for
// why a reading-passage question cannot be re-served on its own.
model MistakeReview {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  contentItemId String
  questionId    String

  /** Leitner box, 1 upwards. A wrong answer sends it back to 1. */
  box Int @default(1)

  dueAt          DateTime
  lastReviewedAt DateTime @default(now())
  reviewCount    Int      @default(0)

  @@unique([userId, contentItemId, questionId])
  @@index([userId, dueAt])
}

enum FeatureRequestStatus {
  OPEN // submitted, no decision taken
  PLANNED
  IN_PROGRESS
  SHIPPED
  DECLINED
}

// The public voting board (site-build-prompt.md section 3a, "Feature Requests page — public
// roadmap or voting board").
//
// It replaces a hard-coded list whose vote counts were invented. Every number this page shows
// now comes from a row somebody created, because the honesty rules forbid fabricated community
// activity, and a board that opens with fake momentum is the clearest possible example of it.
//
// `status` is only ever set by an admin: "Planned" is a promise about our roadmap, and a
// learner voting on a request cannot make that promise on our behalf.
model FeatureRequest {
  id     String  @id @default(cuid())
  title  String
  detail String?

  status FeatureRequestStatus @default(OPEN)

  // Kept nullable so a request outlives the account that suggested it — deleting a user
  // should not silently delete something other people voted for.
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime      @default(now())
  votes     FeatureVote[]

  @@index([status])
  @@index([createdAt])
}

// One vote, by one account, on one request. The unique constraint is the whole anti-stuffing
// story: votes need an account, and the database refuses a second one.
model FeatureVote {
  id String @id @default(cuid())

  requestId String
  request   FeatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@unique([requestId, userId])
  @@index([userId])
}
